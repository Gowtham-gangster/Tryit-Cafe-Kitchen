# ==============================================================================
# TRYIT CAFE & KITCHEN — BACKEND ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Server Configuration
SERVER_PORT=8088
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (Supabase PostgreSQL for Production)
# Accepts either canonical Spring Boot variables or standard DATABASE_* variables:
DATABASE_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_supabase_db_password_here

# (Alternative naming supported by application-prod.yml):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_secure_supabase_db_password_here

# JWT Authentication (STRICT BACKEND SECRET - Minimum 256 bits / 32 characters)
JWT_SECRET=your_64_character_hex_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
CORS_ALLOWED_ORIGINS=https://tryitcafe.com,https://www.tryitcafe.com

# Cloudinary Media Storage (STRICT BACKEND SECRET - Never expose to frontend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Disable local media fallback in production
ALLOW_LOCAL_MEDIA_FALLBACK=false

# Initial Seed Configuration (Optional - set to false in production)
APP_SEED_ENABLED=false
APP_SEED_SAMPLE_DATA=false
OWNER_INITIAL_PHONE=8977774885
OWNER_INITIAL_PASSWORD=Tryit@2026

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# WhatsApp Ordering & Support
WHATSAPP_NUMBER=918977774885
SUPPORT_EMAIL=tryit.cafekichen@gmail.com
