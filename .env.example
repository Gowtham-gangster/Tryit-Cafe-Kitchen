# ==============================================================================
# TRYIT CAFE & KITCHEN — PRODUCTION DEPLOYMENT ENVIRONMENT TEMPLATE
# ==============================================================================
# Target Architecture:
# - Frontend: Vercel (React + Vite SPA)
# - Backend:  Railway (Spring Boot 3.3.5 Docker / JVM 21)
# - Database: Supabase PostgreSQL (Managed PostgreSQL)
# - Media:    Cloudinary Authenticated CDN Storage
#
# IMPORTANT:
# - NEVER commit actual secrets, keys, or passwords to git.
# - Configure these variables in Railway Service Variables and Vercel Project Settings.
# ==============================================================================

# ==============================================================================
# 1. RAILWAY BACKEND VARIABLES (Set in Railway Dashboard > Variables)
# ==============================================================================

# Server & Runtime Configuration
SPRING_PROFILES_ACTIVE=prod
# Railway automatically injects PORT at runtime (Spring Boot reads server.port=${PORT:8080})
PORT=8080

# Database Connection (Supabase PostgreSQL)
# Supports JDBC URL format or URI connection string
DATABASE_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.etuvzbcibjtegtvqptrg
DATABASE_PASSWORD=your_secure_supabase_db_password_here

# Alternative Spring datasource bindings if configured separately:
# SPRING_DATASOURCE_URL=jdbc:postgresql://...
# SPRING_DATASOURCE_USERNAME=...
# SPRING_DATASOURCE_PASSWORD=...

# JWT Authentication
# Secret Status: STRICT BACKEND SECRET (Never expose to browser)
# Generate with: openssl rand -hex 32 (Minimum 256 bits / 32 characters)
JWT_SECRET=your_secure_256_bit_random_hex_jwt_secret_key_here
JWT_EXPIRATION_MS=86400000

# Cloudinary Media Storage (Backend Authenticated Upload Only)
# Secret Status: Cloud Name and Key are public identifiers; Secret is STRICT BACKEND SECRET
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
ALLOW_LOCAL_MEDIA_FALLBACK=false

# CORS Allowed Origins (Comma-separated list of allowed frontend origins, NO trailing slash)
# Include your Vercel deployment domain and any custom domains
CORS_ALLOWED_ORIGINS=https://your-production-domain.vercel.app,https://tryitcafe.com

# Google OAuth 2.0 Web Client ID (Required for Google Identity token verification)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Production Application Seed Settings (Sample data disabled for production)
APP_SEED_ENABLED=false
APP_SEED_SAMPLE_DATA=false
OWNER_INITIAL_PHONE=9999999999
OWNER_INITIAL_PASSWORD=your_secure_initial_owner_password_here

# Support & Contact Defaults
WHATSAPP_NUMBER=918977774885
SUPPORT_EMAIL=tryit.cafekichen@gmail.com

# ==============================================================================
# 2. VERCEL FRONTEND VARIABLES (Set in Vercel Dashboard > Project Settings > Environment Variables)
# ==============================================================================
# Only frontend-safe variables prefixed with VITE_ are allowed here!
# NEVER put CLOUDINARY_API_SECRET, JWT_SECRET, or DATABASE_PASSWORD in Vercel!

# Backend API Base URL (Must use HTTPS and include /api/v1 path)
VITE_API_BASE_URL=https://your-railway-domain.up.railway.app/api/v1

# Google OAuth Web Client ID (Frontend Safe - matches backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google Maps JavaScript API Key (Delivery Interactive Map Pin Selector)
# Must be restricted in Google Cloud Console by HTTP referrer (*.vercel.app/*, etc.)
VITE_GOOGLE_MAPS_API_KEY=your-browser-restricted-google-maps-key

# Public Cafe Contact Information (Displayed to customers)
VITE_CAFE_WHATSAPP_NUMBER=8977774885
VITE_CAFE_PHONE_NUMBER=+918977774885
VITE_CAFE_EMAIL=tryit.cafekichen@gmail.com
VITE_CAFE_INSTAGRAM_URL=https://instagram.com/tryit.cafe_kitchen
VITE_CAFE_INSTAGRAM_HANDLE=@tryit.cafe_kitchen
