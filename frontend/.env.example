# ==============================================================================
# TryIt Cafe & Kitchen - Frontend Environment Variables Template (Vercel)
# ==============================================================================

# Backend API Base URL (Must be HTTPS in production)
# Local Development: http://localhost:8088/api/v1
# Production (Railway): https://your-railway-domain.up.railway.app/api/v1
VITE_API_BASE_URL=https://your-production-api-domain/api/v1

# Google Identity Services / OAuth 2.0 Web Client ID (Frontend Safe)
# NEVER put GOOGLE_CLIENT_SECRET here!
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google Maps JavaScript API Key (Customer interactive delivery location selector)
# Restrict this key by HTTP referrers in Google Cloud Console (e.g. *.vercel.app/*, https://tryitcafe.com/*)
VITE_GOOGLE_MAPS_API_KEY=your-browser-restricted-google-maps-key

# ==============================================================================
# Public Cafe Business Contact & Social Configuration
# ==============================================================================
# Public WhatsApp Business Ordering Number (e.g. 8977774885 or 918977774885)
VITE_CAFE_WHATSAPP_NUMBER=8977774885

# Public Cafe Phone Number (e.g. +918977774885 or 8977774885)
VITE_CAFE_PHONE_NUMBER=+918977774885

# Public Support / Business Email Address (e.g. tryit.cafekichen@gmail.com)
VITE_CAFE_EMAIL=tryit.cafekichen@gmail.com

# Public Instagram Profile URL (e.g. https://instagram.com/tryit.cafe_kitchen)
VITE_CAFE_INSTAGRAM_URL=https://instagram.com/tryit.cafe_kitchen

# Public Instagram Handle (e.g. @tryit.cafe_kitchen)
VITE_CAFE_INSTAGRAM_HANDLE=@tryit.cafe_kitchen

# ==============================================================================
# Legacy Aliases (Supported for backward compatibility)
# ==============================================================================
VITE_WHATSAPP_NUMBER=8977774885
VITE_SUPPORT_EMAIL=tryit.cafekichen@gmail.com
